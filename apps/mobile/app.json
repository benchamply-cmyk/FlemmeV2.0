{
  "expo": {
    "name": "FLEMME",
    "slug": "flemme-mobile",
    "scheme": "flemme-mobile",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.flemme.mobile",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.flemme.mobile"
    },
    "plugins": [
      "expo-secure-store"
    ],
    "icon": "./assets/flemme-icon.png"
  }
}
